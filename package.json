{
  "name": "kcms-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "api:generate": "cp ../kcms-backend/openapi.json src/api/openapi.json && npx -y openapi-typescript@7 src/api/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.9",
    "@fontsource-variable/google-sans": "^5.3.1",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/noto-sans-khmer": "^5.3.0",
    "@headlessui/react": "^2.2.10",
    "@radix-ui/react-label": "^2.1.15",
    "@sentry/react": "^10.73.0",
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
